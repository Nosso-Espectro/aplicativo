{
  "expo": {
    "name": "TEAr",
    "slug": "tear-aplicativo",
    "scheme": "tear",
    "version": "1.0.0",
    "icon": "./assets/branding/tear-icon.png",
    "web": { "favicon": "./assets/branding/tear-icon.png" },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "org.nossoespectro.tear",
      "allowBackup": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS", "android.permission.VIBRATE", "android.permission.RECEIVE_BOOT_COMPLETED"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.nossoespectro.tear",
      "deploymentTarget": "16.4",
      "infoPlist": { "LSApplicationQueriesSchemes": ["whatsapp"] }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-whatsapp-visibility.cjs",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": false,
          "cameraPermission": "Permitir que o TEAr use a câmera para a imagem de um cartão ou etapa de rotina escolhido por você."
        }
      ],
      "expo-font",
      ["expo-notifications", { "enableBackgroundRemoteNotifications": false }],
      "./plugins/with-local-notifications.cjs",
      ["expo-splash-screen", {
        "image": "./assets/branding/tear-icon.png",
        "imageWidth": 240,
        "resizeMode": "contain",
        "backgroundColor": "#233E78",
        "dark": {
          "image": "./assets/branding/tear-icon.png",
          "backgroundColor": "#233E78"
        }
      }]
    ]
  }
}
