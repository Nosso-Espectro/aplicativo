{
  "name": "tear-aplicativo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "npm run build:android && npm run build:ios",
    "build:android": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "build:ios": "expo run:ios --configuration Release --no-bundler"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.28",
    "expo-asset": "57.0.19",
    "expo-audio": "57.0.5",
    "expo-clipboard": "57.0.2",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "57.0.22",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "libphonenumber-js": "1.13.15",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
