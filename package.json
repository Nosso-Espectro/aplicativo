{
  "name": "tear-aplicativo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "npm run build:android && npm run build:ios",
    "build:android": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "build:ios": "expo run:ios --configuration Release --no-bundler"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
