#!/usr/bin/env bash
set -euo pipefail

# Forced SSH command: no arbitrary shell, ref, path or repository from the caller.
request=${SSH_ORIGINAL_COMMAND:-}
if [[ ! "$request" =~ ^(build|artifact)\ ([a-f0-9]{40})$ ]]; then
  printf 'Expected build or artifact followed by a complete commit SHA.\n' >&2
  exit 64
fi
operation=${BASH_REMATCH[1]}
sha=${BASH_REMATCH[2]}
base=/srv/tear-build
artifact="$base/artifacts/$sha/app-release.apk"
exec 9>"$base/build.lock"
flock -w 3600 9

if [[ "$operation" == artifact ]]; then
  [[ -s "$artifact" ]] || { printf 'Artifact unavailable.\n' >&2; exit 66; }
  cat "$artifact"
  exit 0
fi

export PATH=/opt/tear-build/node/bin:/opt/tear-build/android-sdk/cmdline-tools/latest/bin:/opt/tear-build/android-sdk/platform-tools:$PATH
export JAVA_HOME=/opt/tear-build/jdk-17.0.20.1+1
[[ -x "$JAVA_HOME/bin/java" ]] || { printf 'Verified build JDK unavailable.\n' >&2; exit 69; }
export PATH="$JAVA_HOME/bin:$PATH"
export ANDROID_HOME=/opt/tear-build/android-sdk
export ANDROID_SDK_ROOT=$ANDROID_HOME
export GRADLE_USER_HOME="$base/cache/gradle"
export HOME="$base/home"
export ANDROID_USER_HOME="$HOME/.android"
mkdir -p "$base/diagnostics"
chmod 700 "$base/diagnostics"
export JAVA_TOOL_OPTIONS="-Duser.home=$HOME -XX:ErrorFile=$base/diagnostics/$sha-hs_err_pid%p.log"
export EXPO_NO_TELEMETRY=1 CI=1
export GIT_TERMINAL_PROMPT=0
checkout="$base/checkout"
if [[ ! -d "$checkout/.git" ]]; then
  git clone --no-checkout https://github.com/Nosso-Espectro/aplicativo.git "$checkout"
fi
git -C "$checkout" fetch origin main
git -C "$checkout" merge-base --is-ancestor "$sha" origin/main || {
  printf 'Only commits integrated into main may be built.\n' >&2; exit 65;
}
# This disposable checkout belongs only to the build user, not a developer workspace.
git -C "$checkout" reset --hard
git -C "$checkout" clean -ffdx
git -C "$checkout" checkout --detach "$sha"
rm -f "$artifact"
cd "$checkout"
[[ "$(node --version)" == "v$(cat .nvmrc)" ]] || { printf 'Node version mismatch.\n' >&2; exit 69; }
npm ci --include=dev
npx --no-install expo prebuild --platform android --no-install
cd android
./gradlew --no-daemon --max-workers=2 -Pkotlin.compiler.execution.strategy=in-process \
  '-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8' assembleRelease
cd "$checkout"
mkdir -p "$(dirname "$artifact")"
install -m 600 android/app/build/outputs/apk/release/app-release.apk "$artifact"
printf 'Android artifact ready for %s\n' "$sha"
